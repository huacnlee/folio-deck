{
  "id": "com.huacnlee.chat",
  "name": "Chat",
  "version": "0.1.0",
  "shell-version": "0.7.3",
  "entry": "main.js",
  "window": {
    "width": 1180,
    "height": 800
  },
  "dependencies": {
    "zion-ui": "huacnlee/zion-ui"
  },
  "capabilities": {
    "storage": true,
    "fs": {
      "read": [
        "${dataDir}"
      ],
      "write": [
        "${dataDir}"
      ],
      "execute": [
        "/usr/bin/env",
        "fc-match",
        "fc-list"
      ]
    },
    "clipboard": {
      "write": true
    }
  }
}
