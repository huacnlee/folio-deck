{
  "id": "com.huacnlee.finder",
  "name": "Finder",
  "version": "0.1.0",
  "shell-version": "0.7.3",
  "entry": "main.js",
  "capabilities": {
    "storage": true,
    "fs": {
      "read": [
        "/",
        "${dataDir}"
      ],
      "write": [
        "${homeDir}",
        "${dataDir}",
        "${pluginDir}/finder/cache"
      ],
      "execute": [
        "cp",
        "mv",
        "realpath",
        "rm",
        "readlink",
        "fc-match"
      ]
    },
    "clipboard": {
      "write": true
    }
  },
  "window": {
    "width": 1240,
    "height": 820
  }
}
